# Firebase Environment Variables
#
# Bu değerleri Firebase Console'dan alın:
# 1. https://console.firebase.google.com/ adresine gidin
# 2. Projenizi seçin
# 3. Project Settings > General > Your apps
# 4. Web app ekleyin ve config değerlerini kopyalayın
#
# NOT: Bu dosya .gitignore'a eklenmelidir!

REACT_APP_FIREBASE_API_KEY=your-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# Anthropic API (Claude AI) Environment Variables
#
# Bu değeri Anthropic Console'dan alın:
# 1. https://console.anthropic.com/ adresine gidin
# 2. API Keys bölümüne gidin
# 3. Yeni API key oluşturun
#
# NOT: API key olmadan sistem demo modunda çalışır (basit metin analizi)

REACT_APP_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Stripe Payment Environment Variables
#
# Bu değerleri Stripe Dashboard'dan alın:
# 1. https://dashboard.stripe.com/ adresine gidin
# 2. Developers > API keys bölümüne gidin
# 3. Publishable key'i kopyalayın (pk_test_ ile başlar)
#
# NOT: Production'da pk_live_ kullanın, test için pk_test_ kullanın
# NOT: Publishable key public'tir, secret key'i backend'de saklayın

REACT_APP_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
